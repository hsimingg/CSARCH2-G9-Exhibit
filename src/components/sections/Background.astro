<section id="background" class="background-section">
  <div class="carousel-viewport">
    <div class="carousel-track" id="slide-track">
      
      <!-- Slide 1 -->
      <div class="slide">
        <div class="slide-wrapper">
          <div class="info-box">
            <img src="/CSARCH2-G9-Exhibit/astronauts.png" alt="Apollo 11 Astronauts" class="slide-img" />
            <div class="text-content">
              <span class="slide-label">01 Mission</span>
              <h2>MISSION CONTEXT</h2>
              <p class="subtitle">The historic mission to land humans on the Moon.</p>
              <p>
                Apollo 11 is the American spaceflight mission to land humans on the Moon for the first time 
                which launched on July 16, 1969 and returned to Earth on July 24, 1969.
              </p>
              <p>
                After entering orbit, Armstrong and Aldrin entered the Lunar Module Eagle. 
                They detached from the main command module and began their high stakes descent toward the Moon's surface.
              </p>
            </div>
          </div>
          <div class="button-group">
            <button class="btn-prev">← PREV</button>
            <button class="btn-next">NEXT →</button>
          </div>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="slide">
        <div class="slide-wrapper">
          <div class="info-box">
            <img src="/CSARCH2-G9-Exhibit/eagle.png" alt="Rocket" class="slide-img" />
            <div class="text-content">
              <span class="slide-label">02 Descent</span>
              <h2>THE PROBLEM APPEARS</h2>
              <p class="subtitle">The 1202 alarm is flashing during the descent.</p>
              <p>
                As Eagle descended towards the surface, the Apollo Guidance Computer (AGC) suddenly began flashing a 1202 alarm warning to the astronauts.
              </p>
              <p>
                This alarm indicated that the computer's processing core was heavily overloaded with data. 
                The system was receiving more information than it could process while trying to manage the complex landing sequence.
              </p>
            </div>
          </div>
          <div class="button-group">
            <button class="btn-prev">← PREV</button>
            <button class="btn-next">NEXT →</button> 
          </div>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="slide">
        <div class="slide-wrapper">
          <div class="info-box">
            <img src="/CSARCH2-G9-Exhibit/landing.png" alt="The Moon" class="slide-img" />
            <div class="text-content">
              <span class="slide-label">03 Alarm</span>
              <h2>WHY THEY DIDN’T ABORT</h2>
              <p class="subtitle">"Houston, Tranquility Base here, The Eagle has landed."</p>
              <p>
                Mission Control knew from pre-flight simulations that a 1202 alarm did not mean the AGC was broken and endangering the mission.
              </p>
              <p>
                The AGC was automatically dropping low priority tasks to focus all of its processing power on keeping the module flying. 
                Mission Control confidently made the call: GO.
              </p>
            </div>
          </div>
          <div class="button-group">
            <button class="btn-prev">← PREV</button>
            <button class="btn-next">NEXT →</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .background-section {
    padding: 4rem;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .carousel-viewport {
    width: 100%;
    overflow: hidden; 
  }

  .carousel-track {
    display: flex; 
    width: 100%;
    align-items: stretch;
    transition: transform 0.8s ease-in-out; 
  }

  .slide {
    min-width: 100%; 
    display: flex;
    justify-content: center;
  }

  .slide-wrapper {
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .info-box {
    background-color: #18102A;
    border: 1px solid #1E1E45;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px #1E1E45;
    display: flex;
    align-items: center; 
    gap: 3rem; 
    flex-grow: 1;
  }

  .slide-img {
    width: 45%; 
    max-width: 450px;
    border-radius: 8px;
    box-shadow: 0 4px 20px #06060F;
  }

  .text-content {
    flex: 1;
  }

  .slide-label {
    display: block;
    font-size: 0.85rem;
    color: #A78BFA;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #EBE8F4;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 1.1rem;
    color: #A78BFA; 
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  p {
    font-size: 1.05rem;
    color: #F5C800;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .button-group {
    display: flex;
    justify-content: space-between; 
    width: 100%;
    margin-top: 1.5rem;
  }

  .btn-prev, .btn-next {
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    border-radius: 4px;
    background-color: transparent;
    color: #7C3AED;
    border: 2px solid #7C3AED;
    transition: all 0.3s ease;
  }

  .btn-prev:hover, .btn-next:hover {
    background-color: #0B0C1E;
  }

  /* For mobile users */
  @media (max-width: 900px) {
    .background-section {
      padding: 3rem 1.5rem;
    }

    .info-box {
      flex-direction: column; 
      padding: 1.5rem;
      gap: 1.5rem;
      text-align: left;
    }

    .slide-img {
      width: 100%; 
      max-width: 100%;
    }

    h2 {
      font-size: clamp(1.5rem, 6vw, 2rem); 
    }

    .button-group {
      flex-direction: row; 
      gap: 1rem;
    }

    .btn-prev, .btn-next {
      flex: 1; 
      text-align: center;
    }
  }
</style>

<script>
  const track = document.getElementById('slide-track');
  const nextButtons = document.querySelectorAll('.btn-next');
  const prevButtons = document.querySelectorAll('.btn-prev');
  
  let currentSlide = 0;
  const totalSlides = document.querySelectorAll('.slide').length; 

  function updateSlidePosition() {
    const slideAmount = currentSlide * -100;
    if (track) {
      track.style.transform = `translateX(${slideAmount}%)`;
    }
  }

  nextButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateSlidePosition();
    });
  });

  prevButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateSlidePosition();
    });
  });
</script>
