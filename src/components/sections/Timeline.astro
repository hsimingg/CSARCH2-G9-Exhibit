---
// Import your dynamic interactive React timeline component
import ConstellationTimeline from "../ConstellationTimeline.jsx";
---

<section id="timeline">
  <div class="container" style="padding: var(--space-md) 0;">
    <h1 class="section-title" style="margin-bottom: var(--space-xs); text-align: center;">Problem Timeline</h1>
    
    <p style="margin-bottom: var(--space-md); text-align: center; color: var(--text-secondary); max-width: 600px; margin-inline: auto;">
      Trace the critical events of the 1202 alarm sequence. Click each flashing star sequentially to follow the spacecraft's descent.
    </p>

    <ConstellationTimeline client:load />
  </div>
</section>